# ==========================================
# Mozilla Otari Gateway Configuration
# ==========================================

# Base URL of your Otari Gateway instance (default hosted endpoint or local proxy)
OTARI_BASE_URL=https://otari.ai/api/v1

# Virtual API Key from Otari Dashboard (service key or user key)
OTARI_API_KEY=

# Otari Model Catalog / Routing Policy Identifiers
# Role 1: Explainer (open-weight Gemma model)
OTARI_EXPLAINER_MODEL=google/gemma-3-12b-it

# Role 2: SQL Coder / Routing Policy (open-weight Qwen or routing policy configured in Otari)
OTARI_CODER_MODEL=tutor-sql
OTARI_CODER_PRIMARY_MODEL=alibaba/qwen3-coder-30b-a3b-instruct
OTARI_CODER_FALLBACK_MODEL=meta/llama-3.1-70b-instruct

# Role 3: Doc fetcher for official-doc citations (tool-capable open-weight model)
OTARI_DOCS_MODEL=meta/llama-3.1-70b-instruct

# Otari Budget Configuration
OTARI_BUDGET_ID=81dddbd4-c2e9-4174-963b-0f1754c59fa3
OTARI_DAILY_USER_BUDGET=0.05

# Optional Port configuration
PORT=3001
VITE_API_URL=http://localhost:3001
